{
  "name": "@thenavidm/facebook-ad-library-mcp",
  "version": "0.3.0",
  "description": "MCP server for Meta's public Ad Library. Reads the real ad JSON rather than scraping rendered text, so it returns every creative, the true landing URL and the platform list. Free by default with no API key, with optional provider backends. Works with Claude Code, Claude Desktop, Cursor, Windsurf and any MCP-compatible client.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "facebook-ad-library-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez <https://navid.me>",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navidmoazzez/facebook-ad-library-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/navidmoazzez/facebook-ad-library-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "facebook-ads",
    "meta-ad-library",
    "ad-library",
    "competitive-research",
    "ad-intelligence",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ]
}
